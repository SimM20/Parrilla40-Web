# Optional Apache deployment configuration. Use only on the confirmed Apache host.
# If TLS terminates at a reverse proxy, configure HTTPS redirects at that proxy.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The original request check avoids redirecting Apache's internal index lookup.
  RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
  RewriteRule ^index\.html$ https://parrilla40.com.ar/ [R=301,L,NE]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^parrilla40\.com\.ar$ [NC]
  RewriteRule ^ https://parrilla40.com.ar%{REQUEST_URI} [R=301,L,NE]

  # Former .html addresses now live in directories; the browser keeps any #fragment.
  RewriteRule ^index-en\.html/*$ https://parrilla40.com.ar/en/ [R=301,L,NE]
  RewriteRule ^(preguntas|resultados|privacidad|terminos|almacenamiento|retirar-aviso)-en\.html/*$ https://parrilla40.com.ar/$1/en/ [R=301,L,NE]
  RewriteRule ^(preguntas|resultados|privacidad|terminos|almacenamiento|retirar-aviso|ranking-evento)\.html/*$ https://parrilla40.com.ar/$1/ [R=301,L,NE]
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|avif|webp|woff2|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/(resultados|ranking-evento)/#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store"
    Header always set Referrer-Policy "no-referrer"
  </If>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/javascript application/javascript application/json application/xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/xml
  </IfModule>
</IfModule>
